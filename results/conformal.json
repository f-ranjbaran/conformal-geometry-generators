      "n": 600,
      "trace_raw_median": 0.03706405697185358,
      "trace_raw_min": 0.03278413436222633,
      "trace_raw_max": 0.04939905918373266,
      "trace_regularised_median": 0.04986405697185359,
      "eigenvalue_min_median": 4.996207217489845e-06,
      "eigenvalue_max_median": 0.023974911153515677,
