      "eigenvalue_max_median": 0.5409571930818593,
      "regularised_condition_median": 3194.8252281174287
    }
  },
  "conformal_rule": "k = ceil((n_calibration + 1) * (1 - alpha)). The threshold is the k-th smallest calibration score. A test shape is covered when its score is less than or equal to the threshold. k > n would make the threshold infinite.",
  "naive_rule": "threshold = chi2.ppf(1 - alpha, df=128) on the ensemble scores",
  "oracle_rule": "Same conformal rule as split conformal, with scores from the true conditional mean and covariance instead of the ensemble.",
